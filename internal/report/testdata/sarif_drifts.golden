{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "doc-drift-checker",
          "informationUri": "https://github.com/JtheGunner/doc-drift-checker",
          "rules": [
            {
              "id": "doc-drift",
              "shortDescription": {
                "text": "Documentation section may be outdated"
              },
              "help": {
                "text": "Code linked to a documentation section changed while the section's own text did not. Review the section and update it, or acknowledge it with doc-drift-checker ack."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "doc-drift",
          "level": "error",
          "message": {
            "text": "Section \"Usage\" may be outdated: linked code changed but the section did not (changed code: a.go, old.go -> new.go). Broken references: flag --gone (line 5); env-var APP_TOKEN (line 6)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "README.md",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "doc-drift",
          "level": "warning",
          "message": {
            "text": "Section \"Flags\" may be outdated: linked code changed but the section did not (changed code: b.go)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/x.md",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 9
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
